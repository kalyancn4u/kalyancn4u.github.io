---
layout: none
permalink: /search.json
---

[
{% assign docs = site.posts | concat: site.pages %}
{% assign first=true %}
{% for doc in docs %}
{% unless doc.search == false %}
{% unless first %},{% endunless %}
{
"title": {{ doc.title | jsonify }},
"url": {{ doc.url | relative_url | jsonify }},
"content": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }},
"aliases": {{ doc.aliases | join: " " | jsonify }},
"keywords": {{ doc.keywords | join: " " | jsonify }},
"tags": {{ doc.tags | join: " " | jsonify }},
"categories": {{ doc.categories | join: " " | jsonify }}
}
{% assign first=false %}
{% endunless %}
{% endfor %}
]
