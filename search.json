---
layout: none
permalink: /search.json
---

[
{%- assign first = true -%}

{%- assign docs = site.posts -%}

{%- for doc in docs -%}
  {%- unless doc.search == false -%}
    {%- unless first -%},{%- endunless -%}
    {
      "title": {{ doc.title | default: "" | jsonify }},
      "url": {{ doc.url | relative_url | jsonify }},
      "date": {{ doc.date | date: "%Y-%m-%d" | jsonify }},
      "layout": {{ doc.layout | default: "" | jsonify }},
      "excerpt": {{ doc.excerpt | markdownify | strip_html | normalize_whitespace | jsonify }},
      "content": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }},
      "categories": {{ doc.categories | join: " " | jsonify }},
      "tags": {{ doc.tags | join: " " | jsonify }},
      "aliases": {{ doc.aliases | join: " " | jsonify }},
      "keywords": {{ doc.keywords | join: " " | jsonify }},
      "shortcuts": {{ doc.shortcuts | join: " " | jsonify }}
    }
    {%- assign first = false -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign pages = site.pages | where_exp: "p", "p.title != nil" -%}

{%- for doc in pages -%}
  {%- unless doc.search == false -%}
    ,
    {
      "title": {{ doc.title | default: "" | jsonify }},
      "url": {{ doc.url | relative_url | jsonify }},
      "date": "",
      "layout": {{ doc.layout | default: "" | jsonify }},
      "excerpt": "",
      "content": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }},
      "categories": {{ doc.categories | join: " " | jsonify }},
      "tags": {{ doc.tags | join: " " | jsonify }},
      "aliases": {{ doc.aliases | join: " " | jsonify }},
      "keywords": {{ doc.keywords | join: " " | jsonify }},
      "shortcuts": {{ doc.shortcuts | join: " " | jsonify }}
    }
  {%- endunless -%}
{%- endfor -%}

{%- if site.collections.tabs -%}
  {%- for doc in site.collections.tabs.docs -%}
    {%- unless doc.search == false -%}
      ,
      {
        "title": {{ doc.title | default: "" | jsonify }},
        "url": {{ doc.url | relative_url | jsonify }},
        "date": "",
        "layout": {{ doc.layout | default: "" | jsonify }},
        "excerpt": "",
        "content": {{ doc.content | markdownify | strip_html | normalize_whitespace | jsonify }},
        "categories": {{ doc.categories | join: " " | jsonify }},
        "tags": {{ doc.tags | join: " " | jsonify }},
        "aliases": {{ doc.aliases | join: " " | jsonify }},
        "keywords": {{ doc.keywords | join: " " | jsonify }},
        "shortcuts": {{ doc.shortcuts | join: " " | jsonify }}
      }
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

]
